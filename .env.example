# Copy to .env and fill in. Server-only: never prefix with VITE_ (that would ship it to the browser).
# Cursor SDK key (cursor.com/dashboard -> Integrations / API Keys). AI co-designer, local.
CURSOR_API_KEY=
# Google AI Studio key (aistudio.google.com -> Get API key). Free tier; optional fallback.
GEMINI_API_KEY=
# Optional. Only if Hyper3D grants Business-plan API access (default route is the Hyper3D CLI).
HYPER3D_API_KEY=
